
#include <stdio.h>

int factorial(int n)
{
    if (n == 0 || n == 1)
        return 1;
    else
        return n * factorial(n - 1);
}

int main()
{
    int n, result;

    printf("Enter a number: ");
    scanf("%d", &n);

    if (n < 0)
    {
        printf("Factorial is not defined for negative numbers.\n");
    }
    else if (n > 12)
    {
        printf("Please enter a number between 0 and 12.\n");
    }
    else
    {
        result = factorial(n);
        printf("Factorial = %d\n", result);
    }

    return 0;
}
